# Copy to .env. These are the public client settings for the For Catchya connection.
# This publishable key is intended for client apps; authorization is enforced by RLS.
# Never replace it with a secret or service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://hzqzpvaisxnyixqtzets.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aOT4g693q14voXZHaXOnGA_QLB2t9UN

# OAuth callback configured in Supabase Auth > URL Configuration.
# The app uses the CatchYa URI scheme from app.json.

# Set these public values before a production build (not credentials).
EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Set only after completing the device checks in RELEASE.md.
CROSSA_RELEASE_DEVICE_CHECKS=
