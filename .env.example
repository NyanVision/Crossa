# Copy to .env and fill these from your Supabase project's Connect/API settings.
# The publishable/anon key is intended for client apps and is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# OAuth callback configured in Supabase Auth > URL Configuration.
# The app uses the CatchYa URI scheme from app.json.
